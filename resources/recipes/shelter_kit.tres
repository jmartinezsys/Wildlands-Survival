[gd_resource type="Resource" script_class="CraftingRecipe" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/crafting/crafting_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/crafting/recipe_ingredient.gd" id="2_ingredient"]
[ext_resource type="Resource" path="res://resources/items/shelter_kit.tres" id="3_result"]

[sub_resource type="Resource" id="Ingredient_branch"]
script = ExtResource("2_ingredient")
item_id = &"branch"
amount = 5

[sub_resource type="Resource" id="Ingredient_stone"]
script = ExtResource("2_ingredient")
item_id = &"stone"
amount = 2

[resource]
script = ExtResource("1_recipe")
recipe_id = &"shelter_kit"
display_name = "Kit de refugio"
description = "Ramas y piedra para montar un refugio básico."
ingredients = Array[ExtResource("2_ingredient")]( [SubResource("Ingredient_branch"), SubResource("Ingredient_stone")] )
result = ExtResource("3_result")
