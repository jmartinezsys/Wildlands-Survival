[node name="InventoryPanel" type="PanelContainer" parent="."]
visible = false
offset_left = 430.0
offset_top = 150.0
offset_right = 850.0
offset_bottom = 570.0

[node name="Content" type="VBoxContainer" parent="InventoryPanel"]
layout_mode = 2

[node name="Title" type="Label" parent="InventoryPanel/Content"]
layout_mode = 2
