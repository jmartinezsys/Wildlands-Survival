[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/game_hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/environment/weather_overlay.gd" id="2_weather"]

[node name="GameHUD" type="CanvasLayer"]
script = ExtResource("1_hud")
process_mode = 3

[node name="WeatherOverlay" type="Node2D" parent="."]
z_index = -1
script = ExtResource("2_weather")

[node name="Margin" type="MarginContainer" parent="."]
offset_left = 24.0
offset_top = 24.0
offset_right = 480.0
offset_bottom = 160.0

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Prompt" type="Label" parent="Margin/Content"]
visible = false
layout_mode = 2
theme_override_font_sizes/font_size = 20

[node name="Notice" type="Label" parent="Margin/Content"]
visible = false
layout_mode = 2
theme_override_font_sizes/font_size = 18

[node name="NoticeTimer" type="Timer" parent="."]
wait_time = 2.2
one_shot = true

[connection signal="timeout" from="NoticeTimer" to="." method="_on_notice_timer_timeout"]

[node name="StatsPanel" type="PanelContainer" parent="."]
offset_left = 1000.0
offset_top = 24.0
offset_right = 1256.0
offset_bottom = 228.0

