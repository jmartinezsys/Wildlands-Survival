[node name="Energy" type="ProgressBar" parent="StatsPanel/Stats"]
layout_mode = 2
max_value = 100.0
value = 100.0
show_percentage = false

[node name="EnergyLabel" type="Label" parent="StatsPanel/Stats"]
layout_mode = 2
