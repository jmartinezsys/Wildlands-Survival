[connection signal="item_selected" from="InventoryPanel/Content/InventoryList" to="." method="_on_item_selected"]
[connection signal="pressed" from="InventoryPanel/Content/Actions/UseButton" to="." method="_on_use_pressed"]
[connection signal="pressed" from="InventoryPanel/Content/Actions/DropButton" to="." method="_on_drop_pressed"]

